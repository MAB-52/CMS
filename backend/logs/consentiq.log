        lr1_0.published_at,
        lr1_0.recurring_cron,
        lr1_0.rejection_reason,
        lr1_0.reviewed_at,
        lr1_0.reviewed_by,
        lr1_0.reviewer_remarks,
        lr1_0.revision_reason,
        lr1_0.rule_description,
        lr1_0.rule_name,
        lr1_0.rule_type,
        lr1_0.schedule_type,
        lr1_0.scheduled_at,
        lr1_0.status,
        lr1_0.submitted_at,
        lr1_0.trigger_event,
        lr1_0.updated_at,
        c1_0.linked_rule_intent,
        c1_0.published_at,
        c1_0.rejection_reason,
        c1_0.reviewed_at,
        c1_0.reviewed_by,
        c1_0.revision_flagged_combinations,
        c1_0.revision_message,
        c1_0.search_tags,
        c1_0.status,
        c1_0.submitted_at,
        c1_0.tags_used,
        c1_0.updated_at,
        c1_0.validity_end_date,
        c1_0.validity_period_days,
        c1_0.validity_start_date 
    from
        consents c1_0 
    left join
        consent_rules lr1_0 
            on lr1_0.id=c1_0.linked_rule_id 
    left join
        users cb1_0 
            on cb1_0.id=lr1_0.created_by 
    where
        c1_0.status=? 
        and c1_0.created_by<>? 
        and c1_0.linked_rule_intent=0 
    order by
        c1_0.submitted_at desc
