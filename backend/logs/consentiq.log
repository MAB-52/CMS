        c1_0.approve_reason,
        c1_0.category,
        c1_0.channel_email,
        c1_0.channel_push,
        c1_0.channel_rcs,
        c1_0.channel_sms,
        c1_0.channel_whatsapp,
        c1_0.consent_id,
        c1_0.consent_message,
        c1_0.consent_name,
        c1_0.created_at,
        c1_0.created_by,
        c1_0.description,
        c1_0.last_reviewed_combinations,
        lr1_0.id,
        lr1_0.additional_segments,
        lr1_0.approve_reason,
        lr1_0.approved_at,
        lr1_0.broadcast_channels,
        lr1_0.consent_template_id,
        lr1_0.created_at,
        lr1_0.created_by,
        cb1_0.id,
        cb1_0.is_active,
        cb1_0.created_at,
        cb1_0.deleted_at,
        cb1_0.email,
        cb1_0.full_name,
        cb1_0.last_login_at,
        cb1_0.last_login_device,
        cb1_0.last_login_ip,
        cb1_0.password,
        cb1_0.role,
        cb1_0.token_version,
        cb1_0.updated_at,
        lr1_0.execution_active,
        lr1_0.execution_running,
        lr1_0.is_linked_to_consent_workflow,
        lr1_0.last_executed_at,
        lr1_0.last_execution_outcome,
        lr1_0.last_execution_summary,
        lr1_0.next_execution_at,
        lr1_0.predefined_scenario,
        lr1_0.primary_segment,
        lr1_0.published_at,
        lr1_0.recurring_cron,
        lr1_0.rejection_reason,
        lr1_0.reviewed_at,
        lr1_0.reviewed_by,
        lr1_0.reviewer_remarks,
        lr1_0.revision_reason,
        lr1_0.rule_description,
        lr1_0.rule_name,
        lr1_0.rule_type,
        lr1_0.schedule_type,
        lr1_0.scheduled_at,
        lr1_0.status,
        lr1_0.submitted_at,
        lr1_0.trigger_event,
        lr1_0.updated_at,
        c1_0.linked_rule_intent,
        c1_0.published_at,
        c1_0.rejection_reason,
        c1_0.reviewed_at,
        c1_0.reviewed_by,
        c1_0.revision_flagged_combinations,
        c1_0.revision_message,
        c1_0.search_tags,
        c1_0.status,
        c1_0.submitted_at,
        c1_0.tags_used,
        c1_0.updated_at,
        c1_0.validity_end_date,
        c1_0.validity_period_days,
        c1_0.validity_start_date 
    from
        consents c1_0 
    left join
        consent_rules lr1_0 
            on lr1_0.id=c1_0.linked_rule_id 
    left join
        users cb1_0 
            on cb1_0.id=lr1_0.created_by 
    where
        c1_0.status=? 
        and c1_0.created_by<>? 
        and c1_0.linked_rule_intent=0 
    order by
        c1_0.submitted_at desc
