        c1_0.submitted_at,
        c1_0.tags_used,
        c1_0.updated_at,
        c1_0.validity_end_date,
        c1_0.validity_period_days,
        c1_0.validity_start_date 
    from
        consents c1_0 
    left join
        consent_rules lr1_0 
            on lr1_0.id=c1_0.linked_rule_id 
    left join
        users cb1_0 
            on cb1_0.id=lr1_0.created_by 
    left join
        users cb2_0 
            on cb2_0.id=c1_0.created_by 
    where
        c1_0.linked_rule_intent=1 
        and c1_0.status in (?, ?) 
        and cb2_0.id<>? 
    order by
        c1_0.submitted_at desc
