    /**
     * Validates fields that must be consistent on every save (draft or full).
     * Does NOT enforce submission-only rules (VIP segment check etc.).
     */
    private void validateDraft(ConsentRuleUpsertRequest req) {

        // ruleType + scenario coupling
        if (req.getRuleType() == ConsentRuleType.PREDEFINED_SCENARIO
                && req.getPredefinedScenario() == null) {
            throw new IllegalArgumentException(
                    "Predefined scenario is required for scenario-based rules.");
        }

        // Segment validation via segmentation service
        segmentationService.validateSelectableSegments(List.of(req.getPrimarySegment().name()));
        if (req.getAdditionalSegmentCodes() != null && !req.getAdditionalSegmentCodes().isEmpty()) {
            segmentationService.validateSelectableSegments(req.getAdditionalSegmentCodes());
        }

        // Schedule-type coupling
        if (req.getScheduleType() == WorkflowScheduleType.SCHEDULED
                && req.getScheduledAt() == null) {
            throw new IllegalArgumentException(
                    "Scheduled date/time is required for scheduled rules.");
        }
        if (req.getScheduleType() == WorkflowScheduleType.RECURRING
                && !StringUtils.hasText(req.getRecurringCron())) {
            throw new IllegalArgumentException(
                    "Recurring schedule requires a cron expression.");
        }

        // consentTemplateId is @NotNull at the DTO level, but double-check here
        // so the service cannot be called programmatically without it.
        if (req.getConsentTemplateId() == null) {
            throw new IllegalArgumentException("Consent template is required.");
        }
    }

    /**
     * Additional validation run only on submit (not on save-draft / update).
     * Validates business invariants that depend on live system state.
     */
    private void validateForSubmit(ConsentRuleUpsertRequest snapshot, ConsentRule rule) {

        validateDraft(snapshot);

        // VIP fast-track — cannot submit if no VIP customers exist
        if (rule.getRuleType() == ConsentRuleType.PREDEFINED_SCENARIO
                && rule.getPredefinedScenario() == PredefinedRuleScenario.VIP_PRIORITY_FAST_TRACK) {

            boolean noVipCustomers = segmentationService.listAudienceSegments().stream()
                    .filter(s -> AudienceSegmentCode.VIP.name().equals(s.getCode()))
                    .findFirst()
                    .map(s -> s.getCustomerCount() <= 0)
                    .orElse(true);

            if (noVipCustomers) {
                throw new IllegalArgumentException(
                        "VIP fast-track scenario cannot be submitted while no VIP customers exist.");
            }
        }
    }

