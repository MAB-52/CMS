    // PRIVATE — FIELD MAPPING
    // ─────────────────────────────────────────────────────────────────────────

    /**
     * Applies all fields from the request onto the target entity.
     *
     * FIX: consent template is now fetched and set unconditionally whenever
     * consentTemplateId is present. The old code only entered the block if
     * consentTemplateId != null, but the else branch then set the template to
     * null — wiping a previously saved value on unrelated saves.
     * Now null is rejected upstream by @NotNull on the DTO.
     */
    private void applyFields(ConsentRule target, ConsentRuleUpsertRequest req, User createdBy) {

        target.setRuleName(req.getRuleName().trim());
        target.setRuleDescription(req.getRuleDescription());
        target.setRuleType(req.getRuleType());
        target.setPredefinedScenario(req.getPredefinedScenario());
        target.setTriggerEvent(StringUtils.hasText(req.getTriggerEvent())
                ? req.getTriggerEvent().trim() : null);
        target.setPrimarySegment(req.getPrimarySegment());
        target.setAdditionalSegmentCodes(
                req.getAdditionalSegmentCodes() == null
                        ? new ArrayList<>()
                        : new ArrayList<>(req.getAdditionalSegmentCodes()));
        target.setScheduleType(req.getScheduleType());
        target.setScheduledAt(req.getScheduledAt());
        target.setRecurringCron(StringUtils.hasText(req.getRecurringCron())
                ? req.getRecurringCron().trim() : null);
        target.setBroadcastChannels(new ArrayList<>(req.getBroadcastChannels()));

        // ── Consent template (mandatory) ──────────────────────────────────────
        // Fetch from DB to validate existence and status.
        // Throws clearly if the template is missing or not yet approved/published.
        log.info("Executing DB query | method=findById | param=consentTemplateId");
        Consent template = consentRepository.findById(req.getConsentTemplateId())
                .orElseThrow(() -> {
                    log.error("[RULE] Consent template not found — id={}", req.getConsentTemplateId());
                    return new IllegalArgumentException(
                            "Consent template not found: id=" + req.getConsentTemplateId());
                });
        log.info("DB query completed | method=findById | present=true");

        if (template.getStatus() != ConsentStatus.PUBLISHED
                && template.getStatus() != ConsentStatus.APPROVED) {
            log.warn("[RULE] Consent template id={} has invalid status={}",
                    template.getId(), template.getStatus());
            throw new IllegalArgumentException(
                    "Consent template must be in APPROVED or PUBLISHED status, "
                    + "but found: " + template.getStatus());
        }

        target.setConsentTemplate(template);
        log.debug("[RULE] Consent template applied — templateId={} name='{}'",
                template.getId(), template.getConsentName());

        // Set createdBy only on new entities
        if (target.getId() == null) {
            target.setCreatedBy(createdBy);
        }
    }

    /**
     * Reconstructs a lightweight request snapshot from a saved entity.
     * Used by submitForApproval to run validation against the persisted state.
     *
     * NOTE: This reads consentTemplate.getId() inside the same transaction,
     * so lazy loading is safe here. This replaces the old toUpsertFromEntity
     * which could silently return null for lazy-loaded associations.
     */
    private ConsentRuleUpsertRequest toUpsertSnapshot(ConsentRule r) {
        Long templateId = (r.getConsentTemplate() != null) ? r.getConsentTemplate().getId() : null;
        return ConsentRuleUpsertRequest.builder()
                .ruleName(r.getRuleName())
                .ruleDescription(r.getRuleDescription())
                .ruleType(r.getRuleType())
                .predefinedScenario(r.getPredefinedScenario())
                .triggerEvent(r.getTriggerEvent())
                .primarySegment(r.getPrimarySegment())
                .additionalSegmentCodes(r.getAdditionalSegmentCodes())
                .scheduleType(r.getScheduleType())
                .scheduledAt(r.getScheduledAt())
                .recurringCron(r.getRecurringCron())
                .broadcastChannels(r.getBroadcastChannels())
                .consentTemplateId(templateId)
                .build();
    }

